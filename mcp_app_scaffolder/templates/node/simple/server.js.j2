import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";

const server = new McpServer({ name: "{{ app_slug }}", version: "0.1.0" });
const uiMeta = {
  ui: {
    resourceUri: "ui://app/index.html",
    label: "{{ app_display_name }}"
  }
};

{% if demo %}
let count = 0;
server.tool(
  "{{ tool_name }}",
  "Counter tool with increment/decrement operations.",
  { action: "string" },
  async ({ action = "get" }) => {
    if (action === "increment") {
      count += 1;
    } else if (action === "decrement") {
      count -= 1;
    }
    return { content: [{ type: "text", text: JSON.stringify({ count }) }], _meta: uiMeta };
  },
  { _meta: uiMeta }
);
{% else %}
server.tool(
  "{{ tool_name }}",
  "Simple hello tool for {{ app_display_name }}.",
  { name: "string" },
  async ({ name = "world" }) => ({
    content: [{ type: "text", text: `Hello, ${name}!` }],
    _meta: uiMeta
  }),
  { _meta: uiMeta }
);
{% endif %}

server.resource("ui://app/index.html", async () => ({
  contents: [
    {
      uri: "ui://app/index.html",
      mimeType: "text/html",
      text: `<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ app_display_name }}</title>
    <style>
      body { font-family: system-ui, sans-serif; margin: 2rem; }
      button { margin-right: 0.5rem; }
    </style>
  </head>
  <body>
    <h1>{{ app_display_name }}</h1>
    {% if demo %}
    <p>Count: <strong id="count">0</strong></p>
    <button id="dec">-1</button>
    <button id="inc">+1</button>
    {% else %}
    <p>Scaffold generated. Call your tool from this HTML app.</p>
    {% endif %}
    <script type="module">
      import { App } from "@modelcontextprotocol/ext-apps";

      const app = new App();
      window.addEventListener("message", (event) => app.handleMessage(event));
      window.parent.postMessage({ type: "ready", source: "{{ app_slug }}" }, "*");

      {% if demo %}
      const countEl = document.querySelector("#count");
      const incBtn = document.querySelector("#inc");
      const decBtn = document.querySelector("#dec");

      async function apply(action) {
        const result = await app.callTool("{{ tool_name }}", { action });
        const payload = typeof result === "string" ? JSON.parse(result) : result;
        countEl.textContent = String(payload?.count ?? 0);
      }

      incBtn.addEventListener("click", () => apply("increment"));
      decBtn.addEventListener("click", () => apply("decrement"));
      {% endif %}
    </script>
  </body>
</html>`
    }
  ]
}));

const transport = new StdioServerTransport();
await server.connect(transport);

body {
  margin: 0;
  font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
  background: #111827;
  color: #f9fafb;
}

main {
  max-width: 420px;
  margin: 3rem auto;
  padding: 1.5rem;
  background: #1f2937;
  border-radius: 0.75rem;
}

h1 {
  margin-top: 0;
}

.buttons {
  display: flex;
  gap: 0.75rem;
}

button {
  border: 0;
  border-radius: 0.5rem;
  padding: 0.6rem 1rem;
  cursor: pointer;
}

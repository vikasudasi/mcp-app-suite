import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const server = new McpServer({ name: "{{ app_slug }}", version: "0.1.0" });
const uiMeta = {
  ui: {
    resourceUri: "ui://app/index.html",
    label: "{{ app_display_name }}"
  }
};

{% if demo %}
let count = 0;
server.tool(
  "{{ tool_name }}",
  "Counter tool with increment/decrement operations.",
  { action: "string" },
  async ({ action = "get" }) => {
    if (action === "increment") {
      count += 1;
    } else if (action === "decrement") {
      count -= 1;
    }
    return { content: [{ type: "text", text: JSON.stringify({ count }) }], _meta: uiMeta };
  },
  { _meta: uiMeta }
);
{% else %}
server.tool(
  "{{ tool_name }}",
  "Simple hello tool for {{ app_display_name }}.",
  { name: "string" },
  async ({ name = "world" }) => ({
    content: [{ type: "text", text: `Hello, ${name}!` }],
    _meta: uiMeta
  }),
  { _meta: uiMeta }
);
{% endif %}

server.resource("ui://app/index.html", async () => {
  const built = path.join(__dirname, "ui", "dist", "index.html");
  const dev = path.join(__dirname, "ui", "index.html");
  const source = fs.existsSync(built) ? built : dev;
  return { contents: [{ uri: "ui://app/index.html", mimeType: "text/html", text: fs.readFileSync(source, "utf8") }] };
});

const transport = new StdioServerTransport();
await server.connect(transport);
